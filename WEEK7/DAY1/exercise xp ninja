module.exports = (express) => {
	const router = express.Router();
	const emojis = ["😀", "🎉", "🌟", "🎈", "👋"];

	const escapeHtml = (value) =>
		value.replace(/[&<>"']/g, (character) => ({
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			'"': "&quot;",
			"'": "&#39;",
		})[character]);

	const renderPage = (content) => `<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Emoji Greeting</title>
	<style>
		:root { color-scheme: light; font-family: "Trebuchet MS", sans-serif; background: #f2f7f5; color: #203b35; }
		body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; box-sizing: border-box; }
		main { width: min(100%, 440px); padding: 32px; box-sizing: border-box; background: #fff; border: 1px solid #d7e6df; border-radius: 12px; box-shadow: 0 16px 40px #183e2e12; }
		h1 { margin: 0 0 8px; font-size: 1.8rem; }
		p { line-height: 1.5; }
		label { display: block; margin: 20px 0 8px; font-weight: 700; }
		input, select, button { width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #a9c5b8; border-radius: 6px; font: inherit; }
		button { margin-top: 24px; border-color: #176b52; background: #176b52; color: white; font-weight: 700; cursor: pointer; }
		button:hover { background: #105640; }
		.error { padding: 10px 12px; border-left: 4px solid #b03c38; background: #fff1ef; color: #7b211e; }
		.greeting { margin: 24px 0; font-size: 1.4rem; }
		a { color: #176b52; }
		@media (max-width: 480px) { main { padding: 24px; } }
	</style>
</head>
<body>
	${content}
</body>
</html>`;

	const renderForm = (error = "") => renderPage(`<main>
	<h1>Send a little cheer</h1>
	<p>Choose an emoji and get a greeting made just for you.</p>
	${error ? `<p class="error" role="alert">${error}</p>` : ""}
	<form action="/greet" method="post">
		<label for="name">Your name</label>
		<input id="name" name="name" type="text" maxlength="80" autocomplete="name" required>
		<label for="emoji">Choose an emoji</label>
		<select id="emoji" name="emoji">
			${emojis.map((emoji) => `<option value="${emoji}">${emoji}</option>`).join("")}
		</select>
		<button type="submit">Make my greeting</button>
	</form>
</main>`);

	router.get("/", (req, res) => {
		res.type("html").send(renderForm());
	});

	router.post("/greet", (req, res) => {
		const { name, emoji } = req.body || {};
		if (typeof name !== "string" || !name.trim() || name.trim().length > 80) {
			return res.status(400).type("html").send(renderForm("Please enter a name of 1 to 80 characters."));
		}
		if (!emojis.includes(emoji)) {
			return res.status(400).type("html").send(renderForm("Please choose an emoji from the list."));
		}

		const greeting = `Hello, ${escapeHtml(name.trim())} ${emoji}!`;
		res.type("html").send(renderPage(`<main>
			<h1>Your greeting</h1>
			<p class="greeting" role="status">${greeting}</p>
			<a href="/">Make another greeting</a>
		</main>`));
	});

	return router;
};
