<%- include('../partials/head', { title: 'Fact Feed | Search' }) %>
<%- include('../partials/header') %>

<main class="page-wrap">
  <header class="page-title">
    <p class="text-uppercase fw-bold mb-2" style="color: var(--highlight); font-family: Arial, sans-serif;">Explore the archive</p>
    <h1>Find a fact</h1>
    <p class="mb-0">Search by words in a title or browse a category.</p>
  </header>

  <div class="search-forms">
    <form class="search-form" action="/search/title" method="post">
      <label class="form-label" for="search-title">Search by title</label>
      <input
        class="form-control"
        id="search-title"
        name="title"
        type="search"
        list="fact-titles"
        value="<%= searchTitle %>"
        placeholder="Enter a title or keyword"
      >
      <datalist id="fact-titles">
        <% titles.forEach((title) => { %>
          <option value="<%= title %>"></option>
        <% }) %>
      </datalist>
      <button class="btn btn-primary" type="submit">Search titles</button>
    </form>

    <form class="search-form" action="/search/category" method="post">
      <label class="form-label" for="search-category">Browse by category</label>
      <select class="form-select" id="search-category" name="category">
        <option value="" <%= selectedCategory ? '' : 'selected' %>>Choose a category</option>
        <% categories.forEach((category) => { %>
          <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
      <button class="btn btn-primary" type="submit">Show category</button>
    </form>
  </div>

  <%- include('../partials/posts', { posts, errorMessage }) %>
</main>

<%- include('../partials/footer') %>