<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || 'Fact Feed Reader' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      :root {
        color-scheme: light;
        --ink: #173a32;
        --muted: #53675f;
        --paper: #f3f5ef;
        --line: #d3dcd4;
        --accent: #146b53;
        --highlight: #c65c35;
      }

      body {
        min-height: 100vh;
        color: var(--ink);
        background: var(--paper);
        font-family: Georgia, 'Times New Roman', serif;
      }

      .site-nav,
      .site-footer {
        background: var(--ink);
      }

      .site-nav .navbar-brand,
      .site-nav .nav-link,
      .site-footer {
        color: #fff;
      }

      .site-nav .nav-link:hover,
      .site-nav .nav-link:focus {
        color: #e9b08e;
      }

      .page-wrap {
        width: min(100% - 2rem, 900px);
        margin: 0 auto;
        padding: 3rem 0 4rem;
      }

      .page-title {
        max-width: 760px;
        margin-bottom: 2rem;
      }

      .page-title h1 {
        margin-bottom: .75rem;
        font-size: clamp(2.2rem, 7vw, 4rem);
        line-height: 1.05;
      }

      .page-title p,
      .post-meta,
      .site-footer {
        color: var(--muted);
        font-family: Arial, sans-serif;
      }

      .search-forms {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .search-form {
        display: grid;
        align-content: start;
        gap: .65rem;
        font-family: Arial, sans-serif;
      }

      .search-form .form-label {
        margin: 0;
        font-weight: 700;
      }

      .form-control,
      .form-select {
        min-height: 44px;
        border-color: #aebdb4;
        border-radius: 2px;
      }

      .btn-primary {
        width: fit-content;
        min-height: 42px;
        padding: .6rem 1rem;
        border-color: var(--accent);
        border-radius: 2px;
        background: var(--accent);
      }

      .btn-primary:hover,
      .btn-primary:focus {
        border-color: #0d503e;
        background: #0d503e;
      }

      .fact-post {
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--line);
      }

      .fact-post h2 {
        margin: 0 0 .75rem;
        font-size: clamp(1.35rem, 4vw, 1.8rem);
        line-height: 1.2;
      }

      .fact-post h2 a {
        color: var(--ink);
        text-decoration-color: var(--highlight);
        text-underline-offset: .18em;
      }

      .post-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem 1rem;
        margin-bottom: .8rem;
        font-size: .9rem;
      }

      .post-content {
        max-width: 75ch;
        margin: 0;
        line-height: 1.65;
        white-space: pre-line;
      }

      .notice {
        padding: .85rem 1rem;
        border-left: 4px solid var(--highlight);
        background: #fff;
        font-family: Arial, sans-serif;
      }

      .site-footer {
        padding: 1.25rem 1rem;
        color: #fff;
        text-align: center;
      }

      @media (max-width: 520px) {
        .page-wrap {
          padding-top: 2rem;
        }
      }
    </style>
  </head>
  <body>